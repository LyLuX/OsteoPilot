# Copier seulement si .env est absent. Aucun secret par défaut.
NODE_ENV=development
PORT=3008
APP_PUBLIC_URL=http://localhost:5174
# Origine du frontend (port 5174), pas celle de l’API (3008).
# Pour osteopilot.org : ajouter explicitement http://osteopilot.org:5174.
CORS_ORIGINS=http://localhost:5174
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=osteopilot
DATABASE_USER=
DATABASE_PASSWORD=
# Traces SQL masquées, uniquement en développement.
DATABASE_LOGGING=false
# Traces HTTP (méthode, route modèle, statut, durée) en développement.
HTTP_LOGGING=true
# Au moins 32 octets aléatoires ; voir README. Ne jamais réutiliser GreenDesk.
JWT_SECRET=
TRUSTED_PROXIES=false
RATE_LIMIT_API_MAX=500
RATE_LIMIT_LOGIN_MAX=10
# Inscription et envoi d'emails indisponibles dans cette version.
PUBLIC_REGISTRATION_ENABLED=false
MAIL_ENABLED=false
# Premier administrateur : variables temporaires ADMIN_* décrites dans README.
